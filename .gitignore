# Sistema de arquivos
.DS_Store            # Para macOS
Thumbs.db            # Para Windows

# Node.js
node_modules/        # Diretório de dependências
npm-debug.log        # Arquivo de logs do npm

# Arquivos de configuração de IDEs
.vscode/             # Configurações do Visual Studio Code
.idea/               # Configurações do JetBrains (IntelliJ, WebStorm, etc.)

# Diretórios de build
/dist/               # Diretório de build (geralmente usado em projetos com bundlers)
/build/              # Diretório de build para outros bundlers (Webpack, etc.)

# Sass
.sass-cache/         # Cache do Sass

# Arquivos de compilação
*.css.map            # Mapas de arquivo CSS (gerados durante a compilação)
*.scss.map           # Mapas de arquivo SCSS (gerados durante a compilação)
*.sass.map           # Mapas de arquivo SASS (gerados durante a compilação)

# Arquivos temporários
*.log                # Arquivos de log

# Arquivos de ambiente
.env                 # Arquivo de variáveis de ambiente
.env.local           # Arquivo de variáveis de ambiente local
.env.*.local         # Arquivos de ambiente específicos

# Outras configurações que podem ser ignoradas
*.bak                # Arquivos de backup
*.swp                # Arquivos temporários do editor
